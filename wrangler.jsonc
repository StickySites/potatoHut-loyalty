{
  // Secrets (set via wrangler secret put / Cloudflare Dashboard — never commit):
  // NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
  // SUPABASE_SERVICE_ROLE_KEY, LOYALTY_STAMP_THRESHOLD_CENTS,
  // LOYALTY_REDEEM_SECRET, SQUARE_WEBHOOK_SECRET
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "potatohut-loyalty",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "potatohut-loyalty"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
