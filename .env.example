# Supabase (required for live stamps)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional aliases (Cloudflare Workers often omit NEXT_PUBLIC_ for secrets)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Minimum payment (pence/cents) to earn 1 stamp. Default 500 = £5.00
LOYALTY_STAMP_THRESHOLD_CENTS=500

# Shared secret for POST /api/redeem (staff tools). Required to redeem.
LOYALTY_REDEEM_SECRET=generate-a-long-random-string

# Optional shared secret for POST /api/square (Square → this app).
# Send as header: x-loyalty-webhook-secret: <value>
# SQUARE_WEBHOOK_SECRET=

# Optional demo customer when visiting / with no ?customerId=
# DEMO_CUSTOMER_ID=SQ-USER-987654321
